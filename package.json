{
  "name": "cartwise-playwright-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted independent QA portfolio with a fictional storefront and Playwright UI/API tests",
  "scripts": {
    "start": "node app/server.mjs",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:unit": "node --test tests/pricing.unit.mjs",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report"
  },
  "devDependencies": { "playwright": "1.62.1" },
  "engines": { "node": ">=22" }
}
